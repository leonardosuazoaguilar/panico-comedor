---
import { Picture, Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { cliente, foto, waReservar, waLink, telLink, mapsLink, direccionCompleta, horarioTexto } from '../lib/cliente';
import { cargarMenu, precioMXN } from '../lib/menu';
import { schemaRestaurante } from '../lib/schema';

const hero = foto('terraza-fachada')!;
const destacados = (await cargarMenu()).filter((p) => p.destacado && foto(p.foto)).slice(0, 6);
const galeria = ['fachada-comedor', 'tosta-prosciutto-higos', 'croissant', 'torta-cerveza', 'pan-de-muerto', 'tarta-aceitunas'].map((n) => foto(n)!);
const letrero = foto('letrero-panico')!;
const mapa = foto('mapa-panico')!;

const og = await getImage({ src: hero.src, width: 1200, format: 'jpg' });
const imagenesSchema = await Promise.all(
  ['terraza-fachada', 'tosta-prosciutto-higos', 'torta-cerveza'].map(async (n) => new URL((await getImage({ src: foto(n)!.src, width: 1200, format: 'jpg' })).src, cliente.site).href),
);

const titulo = `${cliente.nombre} | ${cliente.tipoCocina} en ${cliente.colonia}, ${cliente.ciudad}`;
const mapaEmbed = `https://www.google.com/maps?q=${encodeURIComponent(`${cliente.nombre}, ${direccionCompleta}`)}&output=embed`;
---
<Base titulo={titulo} descripcion={cliente.descripcionMeta} schema={schemaRestaurante(imagenesSchema)} imagenOg={og.src}>

  <section class="hero">
    <div class="contenedor hero__rejilla">
      <div class="hero__texto">
        <p class="etiqueta">{cliente.nap.referencia} · {cliente.colonia}</p>
        <h1>Pánico <span>Comedor</span></h1>
        <p class="hero__propuesta">{cliente.propuesta}</p>
        <div class="hero__acciones">
          <a class="boton" href="/menu">Ver menú</a>
          <a class="boton boton--claro" href={waReservar} data-evento="reservar" rel="noopener">Reservar por WhatsApp</a>
        </div>
        <p class="hero__dato">
          <strong>Todos los días</strong> {horarioTexto(cliente.horarios[0])} · {cliente.notaHorario}
        </p>
      </div>
      <figure class="hero__foto">
        <Picture
          src={hero.src}
          alt={hero.alt}
          widths={[420, 700, 945]}
          sizes="(min-width: 900px) 55vw, 100vw"
          formats={['avif', 'webp']}
          quality={62}
          loading="eager"
          fetchpriority="high"
        />
        {cliente.petFriendly && <figcaption class="sello">Pet friendly</figcaption>}
      </figure>
    </div>
  </section>

  <section class="seccion" aria-labelledby="destacados-titulo">
    <div class="contenedor">
      <div class="seccion__encabezado">
        <h2 id="destacados-titulo">Lo que más se pide</h2>
        <a class="enlace-flecha" href="/menu">Menú completo <span aria-hidden="true">→</span></a>
      </div>
      <ul class="destacados lista-limpia">
        {destacados.map((p) => {
          const f = foto(p.foto)!;
          return (
            <li class="platillo">
              <Image src={f.src} alt={f.alt} widths={[240, 480]} sizes="(min-width: 900px) 20vw, 50vw" quality={70} class="platillo__foto" />
              <div class="platillo__info">
                <h3>{p.nombre}</h3>
                <p class="platillo__precio">{precioMXN(p.precio)}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section id="nosotros" class="seccion seccion--rosa" aria-labelledby="nosotros-titulo">
    <div class="contenedor nosotros">
      <div>
        <p class="etiqueta">Pan y conservas</p>
        <h2 id="nosotros-titulo">Una panadería que se volvió comedor</h2>
        {cliente.historia.map((p) => <p>{p}</p>)}
      </div>
      <Image src={letrero.src} alt={letrero.alt} widths={[400, 700]} sizes="(min-width: 900px) 40vw, 100vw" quality={70} class="nosotros__foto" />
    </div>
  </section>

  <section class="seccion" aria-labelledby="resenas-titulo">
    <div class="contenedor">
      <div class="seccion__encabezado">
        <h2 id="resenas-titulo">Lo que dicen en Google</h2>
        <a class="enlace-flecha" href={cliente.resenasUrl} rel="noopener">Ver las {cliente.calificacionGoogle.total.toLocaleString('es-MX')} opiniones <span aria-hidden="true">→</span></a>
      </div>
      <p class="calificacion"><span class="calificacion__valor">{cliente.calificacionGoogle.valor.toLocaleString('es-MX')}</span> <span aria-hidden="true">★★★★★</span> <span>promedio en Google Maps</span></p>
      <ul class="resenas lista-limpia">
        {cliente.resenas.map((r) => (
          <li class="resena">
            <p class="resena__estrellas" aria-label={`${r.estrellas} de 5 estrellas`}>{'★'.repeat(r.estrellas)}</p>
            <blockquote><p>{r.texto}</p></blockquote>
            <p class="resena__autor">{r.autor}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {cliente.eventos.length > 0 && (
    <section class="seccion seccion--compacta" aria-labelledby="eventos-titulo">
      <div class="contenedor">
        <h2 id="eventos-titulo" class="visualmente-oculto">Fechas especiales</h2>
        {cliente.eventos.map((e) => (
          <div class="evento">
            <div>
              <p class="etiqueta">Temporada</p>
              <h3>{e.titulo}</h3>
              <p>{e.texto}</p>
            </div>
            <a class="boton" href={waLink(`Hola, me interesa el ${e.titulo.toLowerCase()}.`)} data-evento="whatsapp" rel="noopener">{e.cta}</a>
          </div>
        ))}
      </div>
    </section>
  )}

  <section id="ubicacion" class="seccion seccion--azul" aria-labelledby="ubicacion-titulo">
    <div class="contenedor ubicacion">
      <div>
        <h2 id="ubicacion-titulo">Cómo llegar</h2>
        <address>
          <p class="ubicacion__direccion">{cliente.nap.calle}<br />{cliente.nap.colonia}, {cliente.nap.ciudad}, {cliente.nap.estado} {cliente.nap.cp}</p>
          <p>{cliente.nap.referencia[0].toUpperCase() + cliente.nap.referencia.slice(1)}, a un paso de Plaza Fundadores.</p>
        </address>
        <dl class="horario">
          {cliente.horarios.map((h) => (<><dt>{h.etiqueta}</dt><dd>{horarioTexto(h)}</dd></>))}
          <dt>Desayunos</dt><dd>Hasta la 1:00 pm</dd>
        </dl>
        <div class="ubicacion__acciones">
          <a class="boton boton--crema" href={mapsLink} data-evento="como_llegar" rel="noopener">Abrir en Google Maps</a>
          <a class="boton boton--contorno" href={telLink} data-evento="llamar">Llamar al {cliente.nap.telefono}</a>
        </div>
      </div>
      <div class="mapa" data-mapa={mapaEmbed}>
        <button type="button" class="mapa__boton">
          <span class="mapa__icono" aria-hidden="true">📍</span>
          Mostrar mapa interactivo
          <span class="mapa__nota">Carga Google Maps</span>
        </button>
      </div>
    </div>
    <div class="contenedor sucursales">
      <h3>También somos Pánico</h3>
      <div class="sucursales__rejilla">
        <ul class="lista-limpia">
          {cliente.otrasSucursales.map((s) => (
            <li>
              <strong>{s.nombre}</strong><br />
              {s.direccion}<br />
              <span class="tenue">{s.horario}</span>
            </li>
          ))}
        </ul>
        <Image src={mapa.src} alt={mapa.alt} widths={[340, 679]} sizes="(min-width: 900px) 320px, 90vw" quality={70} class="sucursales__mapa" />
      </div>
    </div>
  </section>

  <section class="seccion" aria-labelledby="galeria-titulo">
    <div class="contenedor">
      <div class="seccion__encabezado">
        <h2 id="galeria-titulo">En Instagram</h2>
        <a class="enlace-flecha" href={cliente.redes.instagram} rel="noopener">{cliente.redes.instagramHandle} <span aria-hidden="true">→</span></a>
      </div>
      <ul class="galeria lista-limpia">
        {galeria.map((g) => (
          <li><Image src={g.src} alt={g.alt} widths={[240, 400]} sizes="(min-width: 900px) 16vw, 33vw" quality={65} /></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  // Mapa diferido: el iframe de Google Maps solo se carga al hacer clic.
  document.querySelectorAll<HTMLElement>('[data-mapa]').forEach((contenedor) => {
    contenedor.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = contenedor.dataset.mapa!;
      iframe.title = 'Mapa de ubicación de Pánico Comedor';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      contenedor.replaceChildren(iframe);
    });
  });
</script>

<style>
  .hero { padding: 16px 0 48px; }
  .hero__rejilla { display: grid; gap: 28px; }
  .hero__foto { order: -1; }
  .hero__foto :global(img) { aspect-ratio: 16 / 10; }
  .hero h1 { margin: 14px 0 12px; }
  .hero h1 span { display: block; color: var(--azulTinta); }
  .hero__propuesta { font-size: 1.15rem; max-width: 34ch; }
  .hero__acciones { display: flex; flex-wrap: wrap; gap: 12px; margin: 24px 0 16px; }
  .hero__dato { font-size: .95rem; color: var(--cafeSuave); }
  .hero__dato strong { color: var(--exito); }
  .hero__foto { position: relative; margin: 0; }
  .hero__foto :global(img) { width: 100%; object-fit: cover; border-radius: var(--radio); box-shadow: var(--sombra); }
  .sello {
    position: absolute; right: 14px; bottom: -16px; background: var(--rosa); color: var(--cafe);
    font-family: var(--fuente-titulos); font-weight: 700; padding: 10px 16px; border-radius: 999px;
    transform: rotate(-4deg); box-shadow: var(--sombra);
  }

  .seccion { padding: 64px 0; }
  .seccion--compacta { padding: 0 0 64px; }
  .seccion--rosa { background: var(--crema2); }
  .seccion--azul { background: var(--azulTinta); color: var(--crema); }
  .seccion__encabezado { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; margin-bottom: 24px; }
  .seccion__encabezado h2 { margin: 0; }
  .enlace-flecha { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }

  .destacados { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .platillo { background: #fff; border-radius: var(--radio); overflow: hidden; box-shadow: var(--sombra); display: flex; flex-direction: column; }
  .platillo :global(.platillo__foto) { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .platillo__info { padding: 12px 14px 14px; display: flex; flex-direction: column; flex: 1; }
  .platillo h3 { font-size: 1.05rem; margin-bottom: 6px; }
  .platillo__precio { margin: auto 0 0; font-weight: 700; color: var(--azulTinta); }
  @media (max-width: 767px) { .platillo:nth-child(odd):last-child { display: none; } }

  .nosotros { display: grid; gap: 32px; align-items: center; }
  .nosotros p:not(.etiqueta) { max-width: 60ch; font-size: 1.05rem; }
  .nosotros h2 { margin-top: 14px; }
  .nosotros :global(.nosotros__foto) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radio); transform: rotate(1.5deg); box-shadow: var(--sombra); }

  .calificacion { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px; margin: -8px 0 24px; color: #8A5A00; }
  .calificacion__valor { font-family: var(--fuente-titulos); font-weight: 800; font-size: 2.4rem; color: var(--cafe); }
  .calificacion span:last-child { color: var(--cafeSuave); }
  .resenas { display: grid; gap: 16px; }
  .resena { background: #fff; border-radius: var(--radio); padding: 22px; box-shadow: var(--sombra); display: flex; flex-direction: column; }
  .resena blockquote { margin: 0 0 12px; flex: 1; }
  .resena__estrellas { color: #8A5A00; letter-spacing: .1em; margin-bottom: 8px; }
  .resena__autor { margin: 0; font-weight: 600; font-size: .95rem; }

  .evento { display: grid; gap: 16px; align-items: center; background: var(--rosa); border-radius: var(--radio); padding: 28px; }
  .evento h3 { font-size: 1.6rem; margin: 12px 0 6px; }
  .evento p:last-child { margin: 0; max-width: 55ch; }

  .ubicacion { display: grid; gap: 32px; }
  .ubicacion address { font-style: normal; }
  .ubicacion__direccion { font-size: 1.3rem; font-family: var(--fuente-titulos); font-weight: 600; line-height: 1.3; }
  .horario { display: grid; grid-template-columns: auto 1fr; gap: 6px 20px; margin: 20px 0 28px; }
  .horario dt { font-weight: 600; }
  .horario dd { margin: 0; }
  .ubicacion__acciones { display: flex; flex-wrap: wrap; gap: 12px; }
  .boton--crema { background: var(--crema); color: var(--cafe); border-color: var(--crema); }
  .boton--contorno { background: transparent; color: var(--crema); border-color: var(--crema); }
  .boton--contorno:hover { background: rgb(244 236 223 / .12); }
  .mapa { min-height: 320px; border-radius: var(--radio); overflow: hidden; background: rgb(244 236 223 / .08); }
  .mapa :global(iframe) { width: 100%; height: 100%; min-height: 320px; border: 0; display: block; }
  .mapa__boton {
    width: 100%; height: 100%; min-height: 320px; border: 2px dashed rgb(244 236 223 / .6); border-radius: var(--radio);
    background: transparent; color: var(--crema); font: 600 1.1rem var(--fuente-texto); cursor: pointer;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
  }
  .mapa__boton:hover { background: rgb(244 236 223 / .08); }
  .mapa__icono { font-size: 2rem; }
  .mapa__nota { font-weight: 400; font-size: .875rem; }
  .sucursales { margin-top: 48px; padding-top: 32px; border-top: 1px solid rgb(244 236 223 / .25); }
  .sucursales__rejilla { display: grid; gap: 24px; align-items: start; }
  .sucursales li { padding: 10px 0; }
  .tenue { opacity: .9; font-size: .95rem; }
  .sucursales :global(.sucursales__mapa) { width: 100%; max-width: 320px; border-radius: 10px; }

  .galeria { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .galeria :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 6px; }

  .visualmente-oculto { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (min-width: 768px) {
    .destacados { grid-template-columns: repeat(3, 1fr); }
    .resenas { grid-template-columns: repeat(3, 1fr); }
    .evento { grid-template-columns: 1fr auto; padding: 36px 40px; }
    .sucursales__rejilla { grid-template-columns: 1fr auto; }
  }
  @media (min-width: 900px) {
    .hero { padding: 48px 0 72px; }
    .hero__rejilla { grid-template-columns: 1fr 1.2fr; align-items: center; gap: 48px; }
    .hero__foto { order: 0; }
    .hero__foto :global(img) { aspect-ratio: 4 / 3; }
    .destacados { grid-template-columns: repeat(5, 1fr); }
    .nosotros { grid-template-columns: 1.3fr 1fr; gap: 64px; }
    .ubicacion { grid-template-columns: 1fr 1.2fr; gap: 48px; }
    .galeria { grid-template-columns: repeat(6, 1fr); gap: 10px; }
    .seccion { padding: 88px 0; }
  }
</style>
