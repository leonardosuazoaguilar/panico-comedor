---
import Base from '../layouts/Base.astro';
import { cliente, waPedir } from '../lib/cliente';
import { cargarMenu, agruparPorCategoria, precioMXN } from '../lib/menu';

const categorias = agruparPorCategoria(await cargarMenu());
const slug = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const titulo = `Menú | ${cliente.nombre} en ${cliente.colonia}, ${cliente.ciudad}`;
const descripcion = `Menú de ${cliente.nombre}: desayunos hasta la 1 pm, pizzas de masa madre, ensaladas, vinos y chelas. Precios y opciones vegetarianas.`;
---
<Base titulo={titulo} descripcion={descripcion}>
  <section class="menu-cabecera">
    <div class="contenedor">
      <p class="etiqueta">{cliente.notaHorario}</p>
      <h1>Menú</h1>
      <p class="menu-intro">Precios en pesos mexicanos, IVA incluido. Pregunta por alérgenos; marcamos los platillos vegetarianos.</p>
      {cliente.demo && (
        <p class="menu-demo"><strong>Menú de demostración.</strong> Los platillos salen de las fotos del Instagram; los precios son ilustrativos y se reemplazan con el menú físico.</p>
      )}
    </div>
    <nav class="categorias" aria-label="Categorías del menú">
      <ul class="contenedor lista-limpia">
        {categorias.map(([cat]) => <li><a href={`#${slug(cat)}`}>{cat}</a></li>)}
      </ul>
    </nav>
  </section>

  <div class="contenedor menu">
    {categorias.map(([cat, platillos]) => (
      <section id={slug(cat)} class="menu__categoria" aria-labelledby={`${slug(cat)}-t`}>
        <h2 id={`${slug(cat)}-t`}>{cat}</h2>
        <ul class="lista-limpia">
          {platillos.map((p) => (
            <li class="item">
              <div class="item__fila">
                <h3>{p.nombre}</h3>
                <span class="item__guia" aria-hidden="true"></span>
                <p class="item__precio">{precioMXN(p.precio)}</p>
              </div>
              {p.descripcion && <p class="item__desc">{p.descripcion}</p>}
              {p.etiquetas.length > 0 && (
                <ul class="item__etiquetas lista-limpia">
                  {p.etiquetas.map((e) => <li class={e.startsWith('vegetariano') || e.startsWith('vegano') ? 'veg' : ''}>{e}</li>)}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}

    <aside class="menu__pedir">
      <h2>¿Para llevar?</h2>
      <p>Escríbenos por WhatsApp y te confirmamos tu pedido.</p>
      <a class="boton" href={waPedir} data-evento="whatsapp" rel="noopener">Pedir por WhatsApp</a>
    </aside>
  </div>
</Base>

<style>
  .menu-cabecera { padding: 40px 0 0; }
  .menu-cabecera h1 { margin: 14px 0 8px; }
  .menu-intro { max-width: 52ch; }
  .menu-demo { background: #fff; border-left: 4px solid var(--amarillo); padding: 12px 16px; border-radius: 8px; max-width: 70ch; font-size: .95rem; }
  .categorias { position: sticky; top: 64px; z-index: 10; background: var(--crema); border-bottom: 1px solid rgb(59 44 34 / .12); margin-top: 16px; }
  .categorias ul { display: flex; gap: 8px; overflow-x: auto; padding: 10px 0; scrollbar-width: none; }
  .categorias a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; white-space: nowrap;
    border: 2px solid var(--cafe); border-radius: 999px; text-decoration: none; font-weight: 600; font-size: .95rem;
  }
  .categorias a:hover { background: var(--cafe); color: var(--crema); }
  .menu { padding: 24px 0 72px; display: grid; gap: 8px; }
  .menu__categoria { scroll-margin-top: 140px; padding-top: 32px; }
  .menu__categoria h2 { font-size: clamp(1.6rem, 5vw, 2.2rem); padding-bottom: 10px; border-bottom: 3px solid var(--cafe); }
  .item { padding: 16px 0; border-bottom: 1px dashed rgb(59 44 34 / .25); }
  .item__fila { display: flex; align-items: baseline; gap: 10px; }
  .item h3 { margin: 0; font-size: 1.15rem; }
  .item__guia { flex: 1; border-bottom: 2px dotted rgb(59 44 34 / .3); min-width: 16px; transform: translateY(-4px); }
  .item__precio { margin: 0; font-weight: 700; font-size: 1.1rem; font-variant-numeric: tabular-nums; }
  .item__desc { margin: 6px 0 0; color: var(--cafeSuave); max-width: 60ch; }
  .item__etiquetas { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .item__etiquetas li { font-size: .8rem; padding: 2px 10px; border-radius: 999px; background: var(--crema2); }
  .item__etiquetas li.veg { background: #DCEBD5; color: #1E4D1F; font-weight: 600; }
  .menu__pedir { margin-top: 48px; background: var(--rosa); padding: 28px; border-radius: var(--radio); }
  .menu__pedir h2 { font-size: 1.8rem; }
  @media (min-width: 900px) {
    .menu { grid-template-columns: 1fr 1fr; column-gap: 64px; }
    .menu__pedir { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    .menu__pedir h2, .menu__pedir p { margin: 0; }
  }
</style>
