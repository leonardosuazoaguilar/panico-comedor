---
import Logo from '../components/Logo.astro';
import { cliente, direccionCompleta, telLink, waLink, waPedir, mapsLink, horarioTexto } from '../lib/cliente';

interface Props {
  titulo: string;
  descripcion: string;
  schema?: object;
  imagenOg?: string;
}
const { titulo, descripcion, schema, imagenOg } = Astro.props;
const t = cliente.tokens;
// Colores del Brand Kit (client.json) como variables CSS.
const tokensCss = `:root{${Object.entries(t).filter(([k]) => !k.startsWith('fuente')).map(([k, v]) => `--${k}:${v}`).join(';')}}`;
const canonical = new URL(Astro.url.pathname, cliente.site).href;
const { ga4, clarity, metaPixel } = cliente.analitica;
const anio = new Date().getFullYear();
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content={t.crema} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_MX" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={canonical} />
  {imagenOg && <meta property="og:image" content={new URL(imagenOg, cliente.site).href} />}
  {cliente.demo && <meta name="robots" content="noindex" />}
  <link rel="preload" href="/fonts/bricolage.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/work-sans.woff2" as="font" type="font/woff2" crossorigin />
  <style is:inline set:html={tokensCss}></style>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  {ga4 && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>
      <script is:inline define:vars={{ ga4 }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date()); gtag('config', ga4);
      </script>
    </>
  )}
  {clarity && (
    <script is:inline define:vars={{ clarity }}>
      (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script",clarity);
    </script>
  )}
  {metaPixel && (
    <script is:inline define:vars={{ metaPixel }}>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', metaPixel); fbq('track', 'PageView');
    </script>
  )}
</head>
<body>
  <a class="saltar" href="#contenido">Saltar al contenido</a>

  {cliente.demo && (
    <p class="aviso-demo">Sitio de demostración: el menú, los precios y las reseñas son de ejemplo.</p>
  )}

  <header class="cabecera">
    <div class="contenedor cabecera__fila">
      <a href="/" class="marca">
        <Logo tam={40} />
        <span class="marca__texto"><span class="marca__nombre">Pánico</span><span class="marca__sub">Comedor</span></span>
      </a>
      <nav aria-label="Principal">
        <ul class="nav">
          <li><a href="/menu">Menú</a></li>
          <li class="solo-escritorio"><a href="/#nosotros">Nosotros</a></li>
          <li class="solo-escritorio"><a href="/#ubicacion">Ubicación</a></li>
          <li class="solo-escritorio"><a class="boton boton--chico" href={waPedir} data-evento="whatsapp" rel="noopener">Pedir por WhatsApp</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="contenido">
    <slot />
  </main>

  <footer class="pie">
    <div class="contenedor pie__rejilla">
      <div>
        <p class="pie__marca"><Logo tam={32} /> {cliente.nombre}</p>
        <address>
          <a href={mapsLink} data-evento="como_llegar" rel="noopener">{direccionCompleta}</a><br />
          ({cliente.nap.referencia})<br />
          <a href={telLink} data-evento="llamar">{cliente.nap.telefono}</a>
        </address>
      </div>
      <div>
        <h2 class="pie__titulo">Horario</h2>
        <ul class="lista-limpia">
          {cliente.horarios.map((h) => <li>{h.etiqueta}: {horarioTexto(h)}</li>)}
          <li>{cliente.notaHorario}</li>
        </ul>
      </div>
      <div>
        <h2 class="pie__titulo">Síguenos</h2>
        <ul class="lista-limpia">
          <li><a href={cliente.redes.instagram} rel="noopener">Instagram {cliente.redes.instagramHandle}</a></li>
          <li><a href={waLink()} data-evento="whatsapp" rel="noopener">WhatsApp {cliente.nap.telefono}</a></li>
          <li><a href="/menu">Menú completo</a></li>
          <li><a href="/aviso-de-privacidad">Aviso de privacidad</a></li>
        </ul>
      </div>
    </div>
    <p class="contenedor pie__legal">© {anio} {cliente.marca}</p>
  </footer>

  <nav class="barra-movil" aria-label="Acciones rápidas">
    <a href={telLink} data-evento="llamar">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
      Llamar
    </a>
    <a href={waLink()} data-evento="whatsapp" rel="noopener">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.8-1.4a.5.5 0 0 0 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3z"/></svg>
      WhatsApp
    </a>
    <a href={mapsLink} data-evento="como_llegar" rel="noopener">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
      Cómo llegar
    </a>
  </nav>

  <script>
    // Registra clics en llamar, WhatsApp, cómo llegar y reservar como eventos de analítica.
    document.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-evento]');
      if (!el) return;
      const evento = el.dataset.evento!;
      const w = window as any;
      w.gtag?.('event', evento, { link_url: (el as HTMLAnchorElement).href });
      w.clarity?.('event', evento);
      w.fbq?.('track', 'Contact', { metodo: evento });
    });
  </script>
</body>
</html>

<style is:global>
  @font-face {
    font-family: 'Bricolage Grotesque';
    src: url('/fonts/bricolage.woff2') format('woff2-variations');
    font-weight: 200 800;
    font-display: swap;
  }
  @font-face {
    font-family: 'Work Sans';
    src: url('/fonts/work-sans.woff2') format('woff2-variations');
    font-weight: 100 900;
    font-display: swap;
  }
  :root {
    --fuente-titulos: 'Bricolage Grotesque', 'Arial Narrow', system-ui, sans-serif;
    --fuente-texto: 'Work Sans', system-ui, sans-serif;
    --radio: 14px;
    --sombra: 0 1px 0 rgb(59 44 34 / .08), 0 8px 24px -12px rgb(59 44 34 / .25);
    --barra-movil: 64px;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--crema);
    color: var(--cafe);
    font: 400 1rem/1.6 var(--fuente-texto);
    padding-bottom: var(--barra-movil);
    -webkit-font-smoothing: antialiased;
  }
  img { max-width: 100%; height: auto; display: block; }
  h1, h2, h3 { font-family: var(--fuente-titulos); line-height: 1.05; letter-spacing: -0.02em; margin: 0 0 .5em; }
  h1 { font-size: clamp(2.6rem, 9vw, 5.2rem); font-weight: 800; }
  h2 { font-size: clamp(1.9rem, 5.5vw, 3rem); font-weight: 750; }
  h3 { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.01em; }
  p { margin: 0 0 1em; }
  a { color: inherit; text-underline-offset: .18em; }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--azulTinta); outline-offset: 3px; border-radius: 6px; }
  .contenedor { width: min(100% - 32px, 1160px); margin-inline: auto; }
  .lista-limpia { list-style: none; padding: 0; margin: 0; }
  .saltar { position: absolute; left: -999px; top: 8px; background: var(--cafe); color: var(--crema); padding: 10px 14px; z-index: 50; }
  .saltar:focus { left: 8px; }
  .aviso-demo { margin: 0; padding: 8px 16px; background: var(--amarillo); color: var(--cafe); font-size: .875rem; text-align: center; }

  .etiqueta {
    display: inline-block; font-family: var(--fuente-titulos); font-weight: 650; text-transform: uppercase;
    letter-spacing: .08em; font-size: .8rem; background: var(--amarillo); color: var(--cafe);
    padding: 4px 10px; border-radius: 6px; transform: rotate(-1.5deg);
  }

  .boton {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 48px; padding: 12px 22px; border-radius: 999px; border: 2px solid var(--cafe);
    background: var(--cafe); color: var(--crema); font-weight: 600; text-decoration: none;
    transition: transform .15s ease, background-color .15s ease;
  }
  .boton:hover { transform: translateY(-2px); }
  .boton--claro { background: transparent; color: var(--cafe); }
  .boton--claro:hover { background: var(--crema2); }
  .boton--chico { min-height: 44px; padding: 8px 16px; font-size: .95rem; }

  .cabecera { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--crema) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid rgb(59 44 34 / .1); }
  .cabecera__fila { display: flex; align-items: center; justify-content: space-between; min-height: 64px; gap: 16px; }
  .marca { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--cafe); min-height: 44px; }
  .marca__texto { display: flex; flex-direction: column; line-height: 1; }
  .marca__nombre { font-family: var(--fuente-titulos); font-weight: 800; font-size: 1.35rem; letter-spacing: .02em; text-transform: uppercase; }
  .marca__sub { font-size: .72rem; letter-spacing: .3em; text-transform: uppercase; }
  .nav { display: flex; align-items: center; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .nav a:not(.boton) { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; font-weight: 600; text-decoration: none; border-radius: 8px; }
  .nav a:not(.boton):hover { background: var(--crema2); }
  .solo-escritorio { display: none; }

  .pie { background: var(--cafe); color: var(--crema); padding: 56px 0 24px; margin-top: 0; }
  .pie a { color: var(--crema); }
  .pie address { font-style: normal; }
  .pie__rejilla { display: grid; gap: 32px; }
  .pie__marca { display: flex; align-items: center; gap: 10px; font-family: var(--fuente-titulos); font-weight: 750; font-size: 1.3rem; }
  .pie__titulo { font-size: 1.1rem; margin-bottom: .6em; }
  .pie .lista-limpia li { padding: 4px 0; }
  .pie .lista-limpia a, .pie address a { display: inline-block; padding: 6px 0; }
  .pie__legal { margin-top: 40px; padding-top: 16px; border-top: 1px solid rgb(244 236 223 / .2); font-size: .875rem; opacity: .85; }

  .barra-movil {
    position: fixed; inset: auto 0 0 0; z-index: 30; display: grid; grid-template-columns: repeat(3, 1fr);
    height: var(--barra-movil); background: var(--cafe); border-top: 1px solid rgb(244 236 223 / .15);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .barra-movil a {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    color: var(--crema); text-decoration: none; font-size: .8rem; font-weight: 600; min-height: 44px;
  }
  .barra-movil a + a { border-left: 1px solid rgb(244 236 223 / .15); }

  @media (min-width: 768px) {
    body { padding-bottom: 0; }
    .barra-movil { display: none; }
    .solo-escritorio { display: list-item; }
    .pie__rejilla { grid-template-columns: 1.4fr 1fr 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    * { transition: none !important; }
  }
</style>
