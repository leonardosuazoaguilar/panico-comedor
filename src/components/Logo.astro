---
// Rebanada de pan con ojos, trazada a partir del letrero del local.
const { tam = 40, titulo } = Astro.props;
---
<svg width={tam} height={tam} viewBox="0 0 64 64" role={titulo ? 'img' : undefined} aria-hidden={titulo ? undefined : 'true'} aria-label={titulo}>
  <path d="M10 26c-5-2-6-8-3-12 4-6 13-9 25-9s21 3 25 9c3 4 2 10-3 12v28c0 3-2 5-5 5H15c-3 0-5-2-5-5z" fill="#F4ECDF" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/>
  <path d="M10 26v28c0 3 2 5 5 5" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>
  <ellipse cx="27" cy="31" rx="5" ry="3" fill="#F4ECDF" stroke="currentColor" stroke-width="2.5"/>
  <ellipse cx="39" cy="31" rx="5" ry="3" fill="#F4ECDF" stroke="currentColor" stroke-width="2.5"/>
  <circle cx="28" cy="31" r="1.6" fill="currentColor"/>
  <circle cx="40" cy="31" r="1.6" fill="currentColor"/>
</svg>
